{
  "name": "@verful/tooling-configs",
  "version": "1.6.0",
  "description": "Shared tooling configs: TSConfig, OXC (oxlint + oxfmt)",
  "keywords": [
    "oxc",
    "oxfmt",
    "oxlint",
    "tsconfig"
  ],
  "license": "MIT",
  "author": "Arthur Emanuel <arthur-er@pm.me>",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./tsconfigs/*": "./dist/tsconfigs/*.json",
    "./oxc/lint": "./dist/lint.mjs",
    "./oxc/fmt": "./dist/fmt.mjs",
    "./oxc/anti-slop": "./dist/anti-slop/index.mjs"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "scripts": {
    "lint": "oxlint",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "checks": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "release": "pnpm build && release-it",
    "test": "node --test \"src/oxc/anti-slop/**/*.test.ts\""
  },
  "dependencies": {
    "@adonisjs/eslint-plugin": "^2.2.2",
    "@oxlint/plugins": "1.87.0",
    "eslint-plugin-perfectionist": "^5.12.1"
  },
  "devDependencies": {
    "@semantic-release/git": "^10.0.1",
    "@types/node": "^24.19.1",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "semantic-release": "^24.0.0",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "oxfmt": ">=0.40.0",
    "oxlint": ">=1.55.0"
  },
  "peerDependenciesMeta": {
    "oxfmt": {
      "optional": true
    },
    "oxlint": {
      "optional": true
    }
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      "@semantic-release/github",
      [
        "@semantic-release/git",
        {
          "assets": [
            "package.json"
          ],
          "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
        }
      ]
    ]
  },
  "packageManager": "pnpm@9.6.0+sha512.38dc6fba8dba35b39340b9700112c2fe1e12f10b17134715a4aa98ccf7bb035e76fd981cf0bb384dfa98f8d6af5481c2bef2f4266a24bfa20c34eb7147ce0b5e"
}
